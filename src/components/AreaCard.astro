---
// src/components/AreaCard.astro
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  heroImage?: string; 
  icon?: string;      
}

const { title, description, href, heroImage, icon = "box" } = Astro.props;

const isImageIcon = icon.includes('.') || icon.startsWith('/');
---

<article class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden flex flex-col hover:shadow-lg transition-shadow duration-300 group">
  <a href={href} class="flex-grow flex flex-col">
    {heroImage ? (
      <div class="aspect-video overflow-hidden">
        <img
          src={heroImage}
          alt={title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    ) : (
      /* Contenedor del icono o imagen de área */
      <div class="aspect-video bg-slate-100 dark:bg-slate-700 flex items-center justify-center overflow-hidden">
        {isImageIcon ? (
          /* La imagen ahora usa w-full h-full y object-cover para llenar todo el espacio */
          <img 
            src={icon} 
            alt={`Imagen de ${title}`} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        ) : (
          <Icon name={icon} class="w-12 h-12 text-slate-400" />
        )}
      </div>
    )}

    <div class="p-6 flex-grow flex flex-col">
      <h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors text-balance">
        {title}
      </h3>
      
      <p class="text-slate-600 dark:text-slate-300 line-clamp-3 text-sm leading-relaxed">
        {description}
      </p>

      <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center text-sm font-medium text-indigo-600 dark:text-indigo-400">
        View Area
        <Icon name="link" class="w-4 h-4 ml-2" />
      </div>
    </div>
  </a>
</article>