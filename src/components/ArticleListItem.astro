---
import { getLink } from '@utils/paths';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  location?: string;
  slug: string;
  externalUrl?: string; 
}

const { title, description, pubDate, updatedDate, tags, author, location, slug, externalUrl } = Astro.props;

const finalHref = externalUrl ? externalUrl : getLink(`/blog/${slug}`);
const target = externalUrl ? "_blank" : "_self";
const rel = externalUrl ? "noopener noreferrer" : undefined;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: '2-digit'
}).format(pubDate);
---

<article class="py-6 first:pt-0 border-b border-slate-200 dark:border-slate-700">
  <div class="grid grid-cols-1 gap-2 md:grid-cols-[90px_1fr] md:items-baseline">
    <div class="text-slate-500 dark:text-slate-400 text-sm font-normal text-right pr-3 whitespace-nowrap">
      {formattedDate}
    </div>
    
    <div>
      <h2 class="text-xl font-bold mb-2 leading-snug">
        <a 
            href={finalHref} 
            target={target} 
            rel={rel}
            class="hover:text-indigo-600 dark:hover:text-indigo-400"
        >
          {title}
          {externalUrl && <span class="text-xs ml-1 text-slate-400">↗</span>}
        </a>
      </h2>
      
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mb-3">
          {tags.map(tag => (
            <a 
              href={getLink(`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`)}
              class="text-xs text-slate-500 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
      
      <p class="text-slate-600 dark:text-slate-300 mb-3 text-sm">
        {description}
      </p>
      
      <div class="flex items-center justify-between text-xs">
        <span class="text-slate-500 dark:text-slate-400">
          {author && `By ${author}`} {location && `at ${location}`}
        </span>
        
        <a 
          href={finalHref}
          target={target}
          rel={rel}
          class="text-indigo-600 dark:text-indigo-400 hover:underline"
        >
          {externalUrl ? 'Read Publication →' : 'Read more →'}
        </a>
      </div>
    </div>
  </div>
</article>