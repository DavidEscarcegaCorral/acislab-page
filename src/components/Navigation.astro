---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import { getSiteConfig, getSocialConfig } from '@utils/config';
import { getLink } from '@utils/paths';

const { class: className } = Astro.props;
const siteConfig = getSiteConfig();
const socialConfig = getSocialConfig();
const pathname = Astro.url.pathname;

function isActive(path: string): boolean {
  if (path === '/') {
    return pathname === path || pathname === getLink('/');
  }
  return pathname.startsWith(path) || pathname.startsWith(getLink(path));
}

// Clases base para los enlaces
const linkClass = "flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium transition-colors";
const activeClass = "bg-indigo-50 text-indigo-700 dark:bg-indigo-500/10 dark:text-indigo-400";
const inactiveClass = "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-100";
---

<nav class:list={["w-full bg-white dark:bg-zinc-900 border-b border-slate-200 dark:border-slate-800 px-4 h-16 flex items-center justify-between", className]}>
  
  {/* 1. IZQUIERDA: Logo y Título */}
  <div class="flex-shrink-0">
    <a href={getLink('/')} class="flex items-center gap-2 text-xl font-bold text-slate-900 dark:text-white">
      <Icon name="book" class="w-6 h-6 text-indigo-600 dark:text-indigo-400" />
      <span>{siteConfig.brandTitle}</span>
    </a>
  </div>

  {/* 2. CENTRO: Enlaces de Navegación (Horizontal) */}
  <div class="hidden md:flex items-center gap-1">
    <a href={getLink('/')} class={`${linkClass} ${isActive('/') ? activeClass : inactiveClass}`}>
      <Icon name="home" class="w-4 h-4" />
      <span>Home</span>
    </a>
    
    <a href={getLink('/blog')} class={`${linkClass} ${isActive('/blog') ? activeClass : inactiveClass}`}>
      <Icon name="file-text" class="w-4 h-4" />
      <span>Blog</span>
    </a>
    
    <a href={getLink('/projects')} class={`${linkClass} ${isActive('/projects') ? activeClass : inactiveClass}`}>
      <Icon name="box" class="w-4 h-4" />
      <span>Projects</span>
    </a>
    
    <a href={getLink('/about')} class={`${linkClass} ${isActive('/about') ? activeClass : inactiveClass}`}>
      <Icon name="user" class="w-4 h-4" />
      <span>About</span>
    </a>
  </div>

  {/* 3. DERECHA: Redes Sociales y Theme Toggle */}
  <div class="flex items-center gap-3">
    {/* Iconos sociales (ocultos en móvil para ahorrar espacio) */}
    <div class="hidden sm:flex items-center gap-1 border-r border-slate-200 dark:border-slate-700 pr-3 mr-1">
      <a href={socialConfig.github} target="_blank" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-500 dark:text-slate-400" aria-label="GitHub">
        <Icon name="github" class="w-5 h-5" />
      </a>
      <a href={socialConfig.linkedin} target="_blank" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors text-slate-500 dark:text-slate-400" aria-label="LinkedIn">
        <Icon name="linkedin" class="w-5 h-5" />
      </a>
    </div>
    
    <ThemeToggle />
  </div>
</nav>