---
// src/layouts/ThreeColumnLayout.astro
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  toc?: {
    depth: number;
    slug: string;
    text: string;
  }[];
}

const { title, description, image, article, toc } = Astro.props;
---

<BaseLayout title={title} description={description} image={image} article={article}>
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 p-4 pt-8">
      
      <main class="lg:col-span-8 w-full">
         <slot />
      </main>

      <aside class="hidden lg:block lg:col-span-4">
        <div class="sticky top-24 space-y-8">
          <Sidebar toc={toc} />
        </div>
      </aside>

  </div>
</BaseLayout>