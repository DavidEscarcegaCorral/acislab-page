---
import ThreeColumnLayout from '@layouts/ThreeColumnLayout.astro';
import { formatPageTitle } from '@utils/config';
---

<ThreeColumnLayout title={formatPageTitle('Members')}>
  <header class="pb-8 border-b border-slate-200 dark:border-slate-800 mb-8">
    <h1 class="text-4xl font-bold mb-4">Team Members</h1>
    <p class="text-lg text-slate-600 dark:text-slate-300">
      Meet the researchers and professionals that make up the ACISLAB team.
    </p>
  </header>

  <div class="prose dark:prose-invert prose-lg max-w-none space-y-8">
    <section>
      <h2>Research Team</h2>
      <p>
        Our team is composed of researchers specialized in various areas of computer science and systems.
        We work collaboratively on research and technology innovation projects.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8 not-prose">
        <div class="p-6 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
          <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Member 1</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">Specialization</p>
          <p class="text-slate-600 dark:text-slate-300 text-sm">
            Information about the team member
          </p>
        </div>

        <div class="p-6 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
          <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Member 2</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">Specialization</p>
          <p class="text-slate-600 dark:text-slate-300 text-sm">
            Information about the team member
          </p>
        </div>

        <div class="p-6 bg-slate-50 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
          <h3 class="font-semibold text-slate-900 dark:text-white mb-2">Member 3</h3>
          <p class="text-sm text-slate-600 dark:text-slate-400 mb-3">Specialization</p>
          <p class="text-slate-600 dark:text-slate-300 text-sm">
            Information about the team member
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2>Collaborators</h2>
      <p>
        In addition to our core team, we have external collaborators who bring
        expertise in different areas of research and development.
      </p>
    </section>
  </div>
</ThreeColumnLayout>

