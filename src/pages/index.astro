---
import ThreeColumnLayout from '@layouts/ThreeColumnLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { getSiteConfig } from '@utils/config';
import AreaCard from '@components/AreaCard.astro';

// IMPORTACIÓN DE IMÁGENES
// Recuerda descomentar esto cuando tengas las imágenes en src/assets/
import healthcareImg from '../assets/healthcare.png'; 
import affectiveImg from '../assets/affective.png';

// LÓGICA DE DATOS
const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

if (featuredPosts.length < 3) {
  const recentPosts = allPosts
    .filter(post => !post.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3 - featuredPosts.length);
  featuredPosts.push(...recentPosts);
}

const allProjects = await getCollection('projects', ({ data }) => true);
const featuredProjects = allProjects
  .filter(project => project.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

if (featuredProjects.length < 2) {
  const recentProjects = allProjects
    .filter(project => !project.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2 - featuredProjects.length);
  featuredProjects.push(...recentProjects);
}

const siteConfig = getSiteConfig();
---

<ThreeColumnLayout title={`Home | ${siteConfig.title}`}>
  
  <header class="pb-8 border-b border-slate-200 dark:border-slate-800 mb-8 text-center md:text-center">
    <h1 class="text-4xl font-bold mb-4 text-slate-900 dark:text-white">{siteConfig.homeTitle}</h1>
    <p class="text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
      {siteConfig.homeSubtitle}
    </p>
  </header>

  <section class="mb-12 border-b border-slate-200 dark:border-slate-800 pb-8">
    <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">About ACISLAB</h2>
    <div class="text-lg text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed text-justify">
      <p>
        <span class="font-semibold text-slate-900 dark:text-white">ACISLAB</span> is a research laboratory based at the Instituto Tecnológico de Sonora (ITSON), Mexico, dedicated to the study and development of human-centered artificial intelligence.

      </p>
      <p>
        Our mission is to design intelligent systems that not only optimize tasks, but are capable of understanding, modeling, and responding to the human cognitive and emotional condition. We believe that the future of artificial intelligence lies in its ability to collaborate with humans in meaningful, transparent, and socially responsible ways.

      </p>
      <p>
        Our research spans foundational work in affective computing and intelligent systems, as well as applied research in healthcare informatics, where we design and deploy intelligent technologies to support caregivers, patients, and healthcare professionals in real-world contexts.

      </p>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Our Research Areas</h2>
    
    <div class="grid gap-6 md:grid-cols-2">
      <AreaCard 
        title="Healthcare-Centered Systems"
        description="Design and application of intelligent systems to support healthcare processes, caregivers, and patients."
        href="/projects/healthcare"
        icon={healthcareImg.src} 
      />
      
      <AreaCard 
        title="Affective Computing & Intelligent Systems"
        description="Systems capable of understanding, modeling, and responding to human cognitive and emotional conditions."
        href="/projects/affective-computing"
        icon={affectiveImg.src}
      />
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Featured Projects</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project: CollectionEntry<'projects'>) => (
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-6 rounded-lg hover:shadow-md transition-shadow flex flex-col">
          <h3 class="text-xl font-bold mb-2 text-slate-900 dark:text-white">
            {project.data.title}
          </h3>
          <p class="text-slate-600 dark:text-slate-300 mb-4 line-clamp-3 text-justify">
            {project.data.description}
          </p>
          <div class="flex gap-2 flex-wrap mb-4 mt-auto">
            {project.data.tags.slice(0,3).map((tag: string) => (
              <span class="text-xs px-2 py-1 bg-slate-100 dark:bg-slate-700 rounded-full text-slate-600 dark:text-slate-300">
                {tag}
              </span>
            ))}
          </div>
          <div class="flex gap-3 pt-2 border-t border-slate-100 dark:border-slate-700">
             {project.data.repoUrl && (
              <a href={project.data.repoUrl} class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline" target="_blank">
                GitHub
              </a>
            )}
            <a href={`/projects/${project.slug}`} class="text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline ml-auto">
               View Details &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-8 text-center md:text-left">
      <a href="/projects" class="inline-block px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors">
        View All Projects
      </a>
    </div>
  </section>

  <section class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 mb-8">
    <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Our Research Vision</h2>
    <div class="text-lg text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed text-justify">
      <p>
        <span class="font-semibold text-slate-900 dark:text-white">ACISLAB</span> operates at the intersection of Affective Computing, Intelligent Systems, Software Engineering, and Human-Computer Interaction.
      </p>
      <p>
        Unlike purely data-driven or “black-box” AI approaches, our research emphasizes formal, explainable, and methodologically grounded models of cognition and emotion.
      </p>
      <p> 
        We develop Computational Models of Emotion, study how emotional processes influence cognition and decision-making, and design architectures for cognitive and affective agents capable of interacting naturally with users.
      </p>
    </div>
  </section>

  <section class="mt-8 mb-12 border-t border-slate-200 dark:border-slate-800 pt-8">
    <h2 class="text-2xl font-bold mb-6 text-slate-900 dark:text-white">Culture and Collaboration</h2>
    <div class="text-lg text-slate-600 dark:text-slate-300 space-y-4 leading-relaxed text-justify">
      <p>
        Under the direction of <span class="font-semibold text-slate-900 dark:text-white">Dr. Luis-Felipe Rodríguez</span>, the laboratory promotes a culture of close collaboration. We focus on training the next generation of researchers.
      </p>
    </div>
    
    <div class="mt-8">
      <a
        href="/about"
        class="inline-flex items-center gap-2 px-5 py-2 border border-slate-300 dark:border-slate-600 hover:border-indigo-500 dark:hover:border-indigo-400 text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 rounded-lg transition-colors bg-transparent"
      >
        <span>Meet Our Team</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </div>
  </section>

</ThreeColumnLayout>